{
  "name": "desktop",
  "productName": "PE Dashboard",
  "private": true,
  "version": "0.9.0",
  "description": "PE Dashboard desktop app",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node build.mjs && ELECTRON_START_URL=http://localhost:5173 electron .",
    "build:bundle": "node build.mjs",
    "dist": "node build.mjs && electron-builder --publish never",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "electron": "42.4.0",
    "electron-builder": "^26.15.2",
    "electron-updater": "^6.3.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  }
}
